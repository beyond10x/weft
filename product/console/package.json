{
  "name": "weft-console",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "node e2e/server.mjs 4417 ../../target/console/dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --maxWorkers=4",
    "e2e": "playwright test --workers=2",
    "shots": "playwright test --workers=2 --config playwright.shots.config.ts"
  },
  "engines": {
    "node": ">=22.0"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@types/node": "22.20.7",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "typescript": "7.0.2",
    "vite": "8.4.0",
    "vitest": "5.1.2"
  }
}
