        "block": "actors",
        "external": true,
        "in": "workstation",
        "kind": "human"
      },
      "pool-daemon": {
        "block": "workloads",
        "checks": {
          "ready": {
            "kind": "http",
            "path": "/status",
            "port": 9090
          }
        },
        "claims": {
          "cpu_millis": 500,
          "memory_mib": 256
        },
        "command": [
          "poold",
          "serve",
          "--web",
          "127.0.0.1:9090"
        ],
        "environment": {
          "POOLD_LOG": "info",
          "POOLD_SLOTS": 8
        },
        "in": "workstation",
        "isolation": "none",
        "kind": "process",
        "package": {
          "kind": "process"
        },
        "ports": [
          {
            "activation": "none",
            "name": "jobs",
            "unix": "${runtime_dir}/poold/jobs.sock"
          },
          {
            "activation": "none",
            "fifo": "${home}/.local/state/poold/jobserver.fifo",
            "name": "jobserver"
          },
          {
            "bind": "loopback",
            "name": "web",
            "protocol": "http",
            "tcp": 9090
          }
        ],
        "run_as": {
          "user": "deployer"
        },
        "shape": "daemon",
        "upgrade": {
          "reload": {
            "signal": "HUP"
          }
        },
        "volumes": [
          {
            "host_path": "${home}/checkouts",
            "mode": "rw",
            "mount": "same"
          },
          {
            "host_path": "${home}/.local/state/poold",
            "mode": "rw",
            "mount": "same"
          }
        ]
      },
      "session": {
        "block": "actors",
        "external": true,
        "in": "workstation",
        "kind": "agent"
      },
      "workstation": {
        "block": "scope",
        "placement": {
          "host": "workstation"
        }
      }
    },
    "summary": "A build-pool daemon on a workstation with a leased build node. The daemon is a host process run as the deploying user; it takes jobs from local clients on a unix socket in the deploying user's runtime directory, hands its jobs a jobserver FIFO under that user's home, both created by the daemon itself, serves a status page on loopback, reads the checkouts in that home at their own path, and pushes trees to the build node and pulls their products back over ssh. Work moves between the two scopes only while their toolchains match. Kubernetes holds none of its processes; generate kubernetes refuses each by name (fixtures/kubernetes/host-daemon). generate systemd writes the units of each scope (fixtures/systemd/host-daemon/<scope>)."
  },
